TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=123456789
TELEGRAM_PROXY=

# Kwork
KWORK_PROJECTS_URL=https://kwork.ru/projects
KWORK_STORAGE_STATE_PATH=./data/kwork-storage.json
KWORK_STORAGE_STATE_JSON=
KWORK_POLL_INTERVAL_SECONDS=120
KWORK_MIN_MATCH_PERCENT=55

# Skills profile used for scoring
SKILLS_PROFILE=Создание сайтов без CMS, Telegram-боты, Telegram Mini App, frontend, backend, HTML, CSS, JavaScript, Python, интеграции API

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://example.com
OPENROUTER_SITE_NAME=Kwork Offer Analyzer

# Optional CSS selectors for Kwork UI
KWORK_OFFER_CARD_SELECTOR=.project-card
KWORK_OFFER_ID_ATTRIBUTE=data-id
KWORK_TITLE_SELECTOR=.wants-card__header-title, .project-card__name, h1, h2
KWORK_DESCRIPTION_SELECTOR=.wants-card__description, .project-card__description, .js-project-description, .description
KWORK_BUDGET_SELECTOR=.wants-card__price, .project-card__price, .price
KWORK_LINK_SELECTOR=a
KWORK_RESPONSE_TEXTAREA_SELECTOR=textarea
KWORK_SUBMIT_BUTTON_SELECTOR=button[type='submit']
